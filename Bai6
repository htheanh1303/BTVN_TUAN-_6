n = int(input("Nhap so mat hang: "))
while n < 1 or n > 20:
    n = int(input("Nhap lai n (1-20): "))
tong_tien = 0
tong_so_luong = 0
for i in range(1, n + 1):
    print("Mat hang thu", i)
    don_gia = float(input("Nhap don gia: "))
    while don_gia <= 0:
        don_gia = float(input("Nhap lai don gia: "))
    so_luong = int(input("Nhap so luong: "))
    while so_luong <= 0:
        so_luong = int(input("Nhap lai so luong: "))
    thanh_tien = don_gia * so_luong
    print("Thanh tien:", thanh_tien)
    tong_tien = tong_tien + thanh_tien
    tong_so_luong = tong_so_luong + so_luong
print("Tong so luong san pham:", tong_so_luong)
print("Tong tien phai thanh toan:", tong_tien)